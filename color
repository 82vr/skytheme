local sizes  = {2, 3, 3, 4, 4, 5, 5, 6}
local alphas = {0.55, 0.45, 0.4, 0.35, 0.3}
local speeds = {5, 6, 7, 8, 9, 10, 11, 13}
local drifts = {-0.04, -0.02, 0, 0.01, 0.03}

local function makeFlake(startY)
    local sz    = sizes[math.random(1, #sizes)]
    local spd   = speeds[math.random(1, #speeds)]
    local alph  = alphas[math.random(1, #alphas)]
    local drift = drifts[math.random(1, #drifts)]
    local f = Instance.new("Frame", mpc)
    f.Size = UDim2.new(0, sz, 0, sz); f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.BackgroundColor3 = Color3.fromRGB(210, 225, 255)
    f.BackgroundTransparency = alph; f.BorderSizePixel = 0; f.ZIndex = 2
    Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
    local function drop()
        local sX = math.random() * 0.96 + 0.01
        local sY = startY or -0.02
        f.Position = UDim2.new(sX, 0, sY, 0)
        f.BackgroundTransparency = alph + 0.1
        TweenService:Create(f, TweenInfo.new(spd * 0.1, Enum.EasingStyle.Quad), {BackgroundTransparency = alph}):Play()
        local endX = math.clamp(sX + drift, 0.01, 0.99)
        TweenService:Create(f, TweenInfo.new(spd, Enum.EasingStyle.Linear), {Position = UDim2.new(endX, 0, 1.06, 0)}):Play()
        task.delay(spd * 0.78, function()
            if f and f.Parent then TweenService:Create(f, TweenInfo.new(spd * 0.22, Enum.EasingStyle.Quad), {BackgroundTransparency = 1}):Play() end
        end)
        task.delay(spd + 0.1, function()
            if mpc and mpc.Parent then drop() end
        end)
    end
    return drop
end
for i = 1, 30 do
    local drop = makeFlake(math.random() * 1.1 - 0.05)
    task.delay(i * 0.15, function() if mpc and mpc.Parent then drop() end end)
end


