local activeBtn = nil

local function CreateThemeButton(data, index)
	local Row = Instance.new("TextButton")
	Row.Name = data.name; Row.Size = UDim2.new(1,-4,0,44)
	Row.BackgroundColor3 = C_ROW; Row.Text = ""
	Row.BorderSizePixel = 0; Row.AutoButtonColor = false
	Row.LayoutOrder = index; Row.Parent = ScrollFrame

	local rc = Instance.new("UICorner"); rc.CornerRadius = UDim.new(0,7); rc.Parent = Row
	local rs = Instance.new("UIStroke"); rs.Color = C_ACCENT; rs.Thickness = 1; rs.Transparency = 0.85; rs.Parent = Row

	-- icon badge
	local Badge = Instance.new("Frame")
	Badge.Size = UDim2.new(0,32,0,32); Badge.Position = UDim2.new(0,8,0.5,-16)
	Badge.BackgroundColor3 = Color3.fromRGB(25,35,75); Badge.BorderSizePixel = 0; Badge.ZIndex = 2; Badge.Parent = Row
	local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0,6); bc.Parent = Badge
	local bs = Instance.new("UIStroke"); bs.Color = C_ACCENT; bs.Thickness = 1; bs.Transparency = 0.6; bs.Parent = Badge

	local IconLabel = Instance.new("TextLabel")
	IconLabel.Size = UDim2.new(1,0,1,0); IconLabel.BackgroundTransparency = 1
	IconLabel.Text = string.sub(data.name,1,2):upper()
	IconLabel.TextColor3 = C_ACCENT; IconLabel.TextSize = 11
	IconLabel.Font = Enum.Font.GothamBold; IconLabel.ZIndex = 3; IconLabel.Parent = Badge

	-- name
	local NameLabel = Instance.new("TextLabel")
	NameLabel.Size = UDim2.new(1,-90,0,22); NameLabel.Position = UDim2.new(0,48,0,7)
	NameLabel.BackgroundTransparency = 1; NameLabel.Text = data.name
	NameLabel.TextColor3 = C_WHITE; NameLabel.TextSize = 13
	NameLabel.Font = Enum.Font.GothamBold; NameLabel.TextXAlignment = Enum.TextXAlignment.Left
	NameLabel.ZIndex = 2; NameLabel.Parent = Row

	-- status
	local StatusLabel = Instance.new("TextLabel")
	StatusLabel.Size = UDim2.new(1,-90,0,14); StatusLabel.Position = UDim2.new(0,48,0,27)
	StatusLabel.BackgroundTransparency = 1; StatusLabel.Text = "Click to apply"
	StatusLabel.TextColor3 = C_SUBTEXT; StatusLabel.TextSize = 10
	StatusLabel.Font = Enum.Font.Gotham; StatusLabel.TextXAlignment = Enum.TextXAlignment.Left
	StatusLabel.ZIndex = 2; StatusLabel.Parent = Row

	-- arrow
	local Arrow = Instance.new("TextLabel")
	Arrow.Size = UDim2.new(0,24,1,0); Arrow.Position = UDim2.new(1,-28,0,0)
	Arrow.BackgroundTransparency = 1; Arrow.Text = ">"
	Arrow.TextColor3 = C_ACCENT; Arrow.TextTransparency = 0.5
	Arrow.TextSize = 16; Arrow.Font = Enum.Font.GothamBold
	Arrow.ZIndex = 2; Arrow.Parent = Row

	Row.MouseEnter:Connect(function()
		if Row ~= activeBtn then
			TweenService:Create(Row, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(28,34,68)}):Play()
			TweenService:Create(rs, TweenInfo.new(0.12), {Transparency = 0.5}):Play()
		end
		TweenService:Create(Arrow, TweenInfo.new(0.12), {TextTransparency = 0}):Play()
	end)
	Row.MouseLeave:Connect(function()
		if Row ~= activeBtn then
			TweenService:Create(Row, TweenInfo.new(0.12), {BackgroundColor3 = C_ROW}):Play()
			TweenService:Create(rs, TweenInfo.new(0.12), {Transparency = 0.85}):Play()
		end
		TweenService:Create(Arrow, TweenInfo.new(0.12), {TextTransparency = 0.5}):Play()
	end)

	Row.MouseButton1Click:Connect(function()
		if activeBtn and activeBtn ~= Row then
			TweenService:Create(activeBtn, TweenInfo.new(0.15), {BackgroundColor3 = C_ROW}):Play()
			local os2 = activeBtn:FindFirstChildOfClass("UIStroke")
			if os2 then TweenService:Create(os2, TweenInfo.new(0.15), {Transparency = 0.85}):Play() end
		end
		activeBtn = Row
		TweenService:Create(Row, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(20,35,85)}):Play()
		TweenService:Create(rs, TweenInfo.new(0.15), {Transparency = 0.1}):Play()

		StatusLabel.Text = "Applying..."; StatusLabel.TextColor3 = C_ACCENT

		local existingSky = game.Lighting:FindFirstChildOfClass("Sky")
		if existingSky then existingSky:Destroy() end
		local newSky = Instance.new("Sky")
		newSky.SkyboxUp = data.Up; newSky.SkyboxDn = data.Dn
		newSky.SkyboxLf = data.Lf; newSky.SkyboxRt = data.Rt
		newSky.SkyboxFt = data.Ft; newSky.SkyboxBk = data.Bk
		newSky.Parent = game.Lighting

		task.wait(0.5)
		StatusLabel.Text = "Active"; StatusLabel.TextColor3 = Color3.fromRGB(80,210,130)
	end)
end

