    statusLbl.BackgroundTransparency = 1
    statusLbl.Text                  = "Click to apply"
    statusLbl.TextColor3            = Color3.fromRGB(100, 120, 200)
    statusLbl.Font                  = Enum.Font.Gotham
    statusLbl.TextSize              = 10
    statusLbl.TextXAlignment        = Enum.TextXAlignment.Left
    statusLbl.ZIndex                = 4

   
    local arrow = Instance.new("TextLabel", btn)
    arrow.Size                  = UDim2.new(0, 20, 1, 0)
    arrow.Position              = UDim2.new(1, -24, 0, 0)
    arrow.BackgroundTransparency = 1
    arrow.Text                  = "›"
    arrow.TextColor3            = accentColor
    arrow.TextTransparency      = 0.6
    arrow.TextSize              = 20
    arrow.Font                  = Enum.Font.GothamBold
    arrow.ZIndex                = 4

   
    btn.MouseEnter:Connect(function()
        if btn ~= activeRow then
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = rowHover}):Play()
            TweenService:Create(btnStroke, TweenInfo.new(0.12), {Transparency = 0.2}):Play()
        end
        TweenService:Create(arrow, TweenInfo.new(0.12), {TextTransparency = 0}):Play()
    end)
    btn.MouseLeave:Connect(function()
        if btn ~= activeRow then
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(16,16,36)}):Play()
            TweenService:Create(btnStroke, TweenInfo.new(0.12), {Transparency = 0.7}):Play()
        end
        TweenService:Create(arrow, TweenInfo.new(0.12), {TextTransparency = 0.6}):Play()
    end)

   
    btn.MouseButton1Click:Connect(function()
        clickSound()

        -- Deselect previous
        if activeRow and activeRow ~= btn then
            TweenService:Create(activeRow, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(16,16,36)}):Play()
            local ps = activeRow:FindFirstChildOfClass("UIStroke")
            if ps then TweenService:Create(ps, TweenInfo.new(0.15), {Transparency = 0.7}):Play() end
        end


        activeRow = btn
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(20, 38, 100)}):Play()
        TweenService:Create(btnStroke, TweenInfo.new(0.15), {Transparency = 0}):Play()

        k
        statusLbl.Text       = "Applying..."
        statusLbl.TextColor3 = accentColor

       
        local existing = game.Lighting:FindFirstChildOfClass("Sky")
        if existing then existing:Destroy() end
        local sky = Instance.new("Sky")
        sky.SkyboxUp = data.Up; sky.SkyboxDn = data.Dn
        sky.SkyboxLf = data.Lf; sky.SkyboxRt = data.Rt
        sky.SkyboxFt = data.Ft; sky.SkyboxBk = data.Bk
        sky.Parent = game.Lighting

        task.wait(0.6)
        statusLbl.Text       = "✓ Active"
        statusLbl.TextColor3 = Color3.fromRGB(80, 210, 130)
    end)
end

